<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes UNITÁRIOS.
    Testam classes isoladas (principalmente Services da Application e
    regras da Domain), usando Moq para simular dependências como
    repositórios — sem tocar em banco de dados real.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AdegaDoRatao.Domain\AdegaDoRatao.Domain.csproj" />
    <ProjectReference Include="..\..\src\AdegaDoRatao.Application\AdegaDoRatao.Application.csproj" />
  </ItemGroup>

</Project>
