<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Camada de INFRAESTRUTURA.
    Aqui vivem os detalhes "sujos": Entity Framework Core, acesso ao
    SQL Server, geração/validação de JWT, hashing de senha, configuração
    do Serilog. Esta camada IMPLEMENTA as interfaces definidas em
    Domain/Application (ex.: IProductRepository é implementado aqui por
    ProductRepository, usando o AppDbContext).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AdegaDoRatao.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity Framework Core + provider do PostgreSQL (Npgsql) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Geração e validação de tokens JWT -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.2" />

    <!-- Hash seguro de senha -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- Logging estruturado -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <!-- Opções tipadas para configurações como Jwt. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />

    <!-- Navegador automatizado para os coletores de preço (Shibata/Sonda) -->
    <PackageReference Include="Microsoft.Playwright" Version="1.49.0" />

    <!-- HttpClient tipado via IHttpClientFactory + cache em memória (integração Data Market) -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdegaDoRatao.Domain\AdegaDoRatao.Domain.csproj" />
    <ProjectReference Include="..\AdegaDoRatao.Application\AdegaDoRatao.Application.csproj" />
  </ItemGroup>

</Project>
